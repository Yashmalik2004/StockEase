# ==============================================================================
# StockEase – Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit actual credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Docker Compose Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGO_INITDB_DATABASE=stockease

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
PORT=5000
# For Docker Compose, the backend connects to MongoDB service:
# MONGO_URI=mongodb://mongodb:27017/stockease
# For local development outside Docker:
MONGO_URI=mongodb://localhost:27017/stockease

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Allowed frontend origin for CORS
# In Docker Compose: http://localhost:3000 | In Local Dev: http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend Client Configuration
# ------------------------------------------------------------------------------
# In Docker with Nginx reverse proxy, leave empty or set to relative "/"
VITE_API_URL=
