# ==============================================================================
# StockEase – Kubernetes Secret Template (EXAMPLE)
# Copy this file to secret.yaml (or apply via kubectl command)
# DO NOT commit production secrets or actual credentials to version control.
# ==============================================================================
#
# To apply this secret directly:
#   kubectl apply -f kubernetes/secret.yaml.example
#
# Or create it dynamically using kubectl:
#   kubectl create secret generic stockease-secret \
#     --from-literal=JWT_SECRET=your_secure_random_jwt_secret_key_min_32_chars \
#     -n stockease
# ==============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: stockease-secret
  namespace: stockease
  labels:
    app.kubernetes.io/name: stockease-secret
    app.kubernetes.io/part-of: stockease
type: Opaque
stringData:
  # Development placeholder - replace with a secure random key for production
  JWT_SECRET: "stockease_jwt_dev_secret_key_change_in_production_min_32_chars"
